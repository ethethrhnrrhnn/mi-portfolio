---
---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/png" href="/earth.png" />
<title>Contact — Nicolas Joannes</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&display=swap');
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Inter',sans-serif;background:#f8f8f6;color:#0c0c0c;min-height:100vh;display:flex;flex-direction:column;opacity:0;transition:opacity .5s ease}

nav{
  position:fixed;top:1.1rem;left:50%;transform:translateX(-50%);
  width:calc(100% - 3.5rem);max-width:1120px;
  padding:.65rem 1rem .65rem 1.4rem;
  display:flex;justify-content:space-between;align-items:center;
  z-index:200;
  background:linear-gradient(145deg,rgba(28,28,28,0.58) 0%,rgba(12,12,12,0.48) 100%);
  backdrop-filter:blur(24px) saturate(160%);
  -webkit-backdrop-filter:blur(24px) saturate(160%);
  border:1px solid rgba(255,255,255,0.11);
  border-radius:100px;
  box-shadow:
    inset 0 1.5px 0 rgba(255,255,255,0.22),
    inset 0 -1px 0 rgba(255,255,255,0.04),
    inset 1px 0 rgba(255,255,255,0.06),
    inset -1px 0 rgba(255,255,255,0.06),
    0 8px 32px rgba(0,0,0,0.24),
    0 2px 6px rgba(0,0,0,0.14);
  transition:box-shadow .5s ease,background .5s ease;
}
nav:hover{
  background:linear-gradient(145deg,rgba(30,30,30,0.64) 0%,rgba(14,14,14,0.54) 100%);
  box-shadow:
    inset 0 1.5px 0 rgba(255,255,255,0.3),
    inset 0 -1px 0 rgba(255,255,255,0.06),
    inset 1px 0 rgba(255,255,255,0.08),
    inset -1px 0 rgba(255,255,255,0.08),
    0 12px 40px rgba(0,0,0,0.3),
    0 2px 6px rgba(0,0,0,0.18);
}
.logo{font-size:.66rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,0.88);text-decoration:none;padding:.3rem .2rem}
a{text-decoration:none}
nav ul{list-style:none;display:flex;gap:.25rem;align-items:center}
nav ul li a{
  position:relative;display:block;
  color:rgba(255,255,255,0.65);
  font-size:.63rem;font-weight:500;letter-spacing:.16em;text-transform:uppercase;
  padding:.42rem .85rem;border-radius:100px;
  transition:color .3s ease;isolation:isolate;
}
nav ul li a::before{
  content:'';position:absolute;inset:0;z-index:-1;
  border-radius:100px;
  background:rgba(255,255,255,0.11);
  border:1px solid rgba(255,255,255,0.1);
  box-shadow:inset 0 1px 0 rgba(255,255,255,0.18);
  transform:scale(0.65) translateY(2px);opacity:0;
  transition:
    transform .5s cubic-bezier(0.34,1.56,0.64,1),
    opacity .3s ease,
    border-radius .5s cubic-bezier(0.34,1.56,0.64,1);
}
nav ul li a:hover{color:rgba(255,255,255,1)}
nav ul li a:hover::before{transform:scale(1) translateY(0);opacity:1;border-radius:38% 62% 55% 45% / 45% 40% 60% 55%}

.page{flex:1;display:flex;flex-direction:column;justify-content:center;padding:0 3rem;max-width:700px;margin:0 auto;width:100%}

.contact-link{display:flex;justify-content:space-between;align-items:center;padding:1.4rem 0;border-top:1px solid rgba(12,12,12,0.08);text-decoration:none;color:#0c0c0c;transition:opacity .2s}
.contact-link:last-child{border-bottom:1px solid rgba(12,12,12,0.08)}
.contact-link:hover{opacity:.38}
.label{font-size:.58rem;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:rgba(12,12,12,0.38)}
.value{font-size:1.5rem;font-weight:400;letter-spacing:-.01em}
.arrow{font-size:1rem;opacity:.28}

@media(max-width:768px){
  nav{top:.7rem;width:calc(100% - 2rem);padding:.55rem .6rem .55rem 1rem}
  nav ul{gap:.15rem}
  .page{padding:0 1.5rem}
  .value{font-size:1.1rem}
}

</style>
</head>
<body>

<nav>
  <a href="/" class="logo">Nicolas Joannes</a>
  <ul>
    <li><a href="/work">Work</a></li>
    <li><a href="/contact">Contact</a></li>
  </ul>
</nav>

<div class="page">
  <a href="mailto:nico.gil.arboli@gmail.com" class="contact-link">
    <span class="label">Email</span>
    <span class="value">nico.gil.arboli@gmail.com</span>
    <span class="arrow">↗</span>
  </a>
  <a href="https://linkedin.com/in/njoannes" target="_blank" class="contact-link">
    <span class="label">LinkedIn</span>
    <span class="value">njoannes</span>
    <span class="arrow">↗</span>
  </a>
</div>

<script>
function showPage() { document.body.style.opacity = '1'; }
if (document.readyState === 'complete') { showPage(); } else { window.addEventListener('load', showPage); }
window.addEventListener('pageshow', showPage);
window.addEventListener('pagehide', e => { if ((e as PageTransitionEvent).persisted) { document.body.style.transition = 'none'; document.body.style.opacity = '1'; } });
</script>

</body>
</html>
