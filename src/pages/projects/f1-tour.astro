---
---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/png" href="/earth.png" />
<title>Autonomous F1 Vehicle — Nicolas Joannes</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400&display=swap');
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Inter',sans-serif;background:url('/Backgrounds.svg') repeat center/100px 100px;color:#1a1a1a}
nav{position:fixed;top:0;left:0;width:100%;padding:2rem 3rem;display:flex;justify-content:space-between;z-index:100;background:#f7f6f3}
nav a{text-decoration:none;color:#1a1a1a;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;opacity:.5}
nav a:hover{opacity:1}
.content{max-width:900px;margin:0 auto;padding:8rem 2rem 6rem}
.meta{display:flex;gap:4rem;margin-bottom:4rem;padding-bottom:2rem;border-bottom:1px solid #e0e0e0}
.meta-item span{font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;color:#999;display:block;margin-bottom:.4rem}
.meta-item p{font-size:.9rem}
h1{font-family:'Inter',sans-serif;font-size:clamp(2.5rem,5vw,4rem);font-weight:400;line-height:1.1;margin-bottom:3rem}
.slide{width:100%;display:block;margin:2rem 0;border-radius:4px;object-fit:contain;transition:transform 0.3s ease,box-shadow 0.3s ease;cursor:zoom-in}
.slide:hover{transform:scale(1.02);box-shadow:0 20px 60px rgba(0,0,0,0.12)}
footer{padding:3rem;border-top:1px solid #ddd;display:flex;justify-content:space-between;font-size:.75rem;color:#999}
footer a{color:#999;text-decoration:none}
#lightbox{position:fixed;inset:0;background:rgba(0,0,0,0.92);display:flex;align-items:center;justify-content:center;z-index:1000;opacity:0;pointer-events:none;transition:opacity .3s ease;cursor:zoom-out}
#lightbox.open{opacity:1;pointer-events:auto}
#lightbox img{max-width:90vw;max-height:90vh;object-fit:contain}
</style>
</head>
<script>
document.querySelectorAll('.slide').forEach(el => {
  const img = el as HTMLElement;
  img.addEventListener('mouseenter', () => {
    img.style.transform = 'scale(1.02)';
    img.style.boxShadow = '0 20px 60px rgba(0,0,0,0.12)';
  });
  img.addEventListener('mouseleave', () => {
    img.style.transform = 'scale(1)';
    img.style.boxShadow = 'none';
  });
});
</script>
<body>

<nav>
  <a href="/">← Back</a>
  <a href="/">Nicolas Joannes</a>
</nav>

<div class="content">
  <div class="meta">
    <div class="meta-item"><span>Category</span><p>Automotive Design</p></div>
    <div class="meta-item"><span>Year</span><p>2026</p></div>
    <div class="meta-item"><span>Type</span><p>Industrial Design</p></div>
  </div>

  <h1>Autonomous F1 Vehicle</h1>

  <img class="slide" src="/f1.png" alt="Slide 1" />
  <img class="slide" src="/f2.png" alt="Slide 2" />
  <img class="slide" src="/f3.png" alt="Slide 3" />
  <img class="slide" src="/f4.png" alt="Slide 4" />
  <img class="slide" src="/f5.png" alt="Slide 5" />
  <img class="slide" src="/f6.png" alt="Slide 6" />
  <img class="slide" src="/f7.png" alt="Slide 7" />
</div>

<footer>
  <span>© 2026 Nicolas Joannes</span>
  <a href="/">← All projects</a>
</footer>

<div id="lightbox"><img id="lightbox-img" src="" alt="" /></div>
<script>
const lb = document.getElementById('lightbox') as HTMLElement;
const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
const slides = Array.from(document.querySelectorAll('.slide')) as HTMLImageElement[];
let lbIndex = 0;
slides.forEach((el, i) => {
  el.addEventListener('click', () => { lbIndex = i; lbImg.src = el.src; lb.classList.add('open'); });
});
lb.addEventListener('click', () => lb.classList.remove('open'));
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') { lb.classList.remove('open'); return; }
  if (!lb.classList.contains('open')) return;
  if (e.key === 'ArrowRight') { lbIndex = (lbIndex + 1) % slides.length; lbImg.src = slides[lbIndex].src; }
  if (e.key === 'ArrowLeft') { lbIndex = (lbIndex - 1 + slides.length) % slides.length; lbImg.src = slides[lbIndex].src; }
});
</script>
</body>
</html>
