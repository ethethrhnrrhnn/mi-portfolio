---
import fs from 'node:fs';
const protoUrl =
  'https://embed.figma.com/proto/mHkbeEyZYY7Whn4YErCimD/The-Unite-Gym?node-id=13-351&starting-point-node-id=13%3A351&scaling=contain&content-scaling=fixed&hide-ui=1&embed-host=share';
const slides = [
  { src: '/unite-gym-1.jpg', alt: 'Tap your card to begin' },
  { src: '/unite-gym-2.jpg', alt: 'Personal home screen with streak and live availability' },
  { src: '/unite-gym-3.jpg', alt: 'Today is chest day: a routine built around free machines' },
  { src: '/unite-gym-4.jpg', alt: 'Routine map drawing the path between stations' },
  { src: '/unite-gym-5.jpg', alt: 'Live availability heat map of the gym floor' },
  { src: '/unite-gym-6.jpg', alt: 'Workout buddy match' },
].filter(s => fs.existsSync(`./public${s.src}`));
---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/png" href="/earth.png" />
<title>The Unite Gym — Nicolas Joannes</title>
<meta name="description" content="The Unite Gym: a tap-your-card gym kiosk that plans routines around free machines, maps live availability and pairs members with workout buddies." />
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400&display=swap');
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Inter',sans-serif;background:#f7f6f3;color:#1a1a1a}
nav{position:fixed;top:0;left:0;width:100%;padding:2rem 3rem;display:flex;justify-content:space-between;z-index:100}
nav a{text-decoration:none;color:#1a1a1a;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;opacity:.5}
nav a:hover{opacity:1}
.hero{width:min(1280px,94vw);margin:7rem auto 0;border-radius:8px;overflow:hidden;background:#dedde3;box-shadow:0 30px 80px rgba(0,0,0,.10)}
.hero video,.hero img{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover}
.content{max-width:900px;margin:0 auto;padding:4rem 2rem 6rem}
.meta{display:flex;gap:4rem;margin-bottom:4rem;padding-bottom:2rem;border-bottom:1px solid #e0e0e0;flex-wrap:wrap}
.meta-item span{font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;color:#999;display:block;margin-bottom:.4rem}
.meta-item p{font-size:.9rem}
h1{font-family:'Inter',sans-serif;font-size:clamp(2.5rem,5vw,4rem);font-weight:400;line-height:1.1;margin-bottom:2rem}
.lead{font-size:1.15rem;line-height:1.6;font-weight:300;max-width:680px;margin-bottom:1.5rem}
.brief{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin:3rem 0 4rem}
.brief h2{font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;color:#999;font-weight:400;margin-bottom:.6rem}
.brief p{font-size:.9rem;line-height:1.6;font-weight:300}
.research{font-size:1rem;line-height:1.7;font-weight:300;max-width:680px;margin-bottom:4rem}
.research strong{font-weight:400}
.report-link{display:inline-flex;align-items:center;gap:.6rem;margin:-2rem 0 4rem;padding:.9rem 1.4rem;border:1px solid #1a1a1a;border-radius:999px;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;color:#1a1a1a;text-decoration:none;transition:background .2s ease,color .2s ease}
.report-link:hover{background:#1a1a1a;color:#f7f6f3}
.proto{width:min(1280px,94vw);margin:0 0 1rem calc(50% - min(1280px,94vw)/2)}
.proto-frame{position:relative;width:100%;aspect-ratio:1194/834;border-radius:8px;overflow:hidden;background:#0c4252;box-shadow:0 30px 80px rgba(0,0,0,.12)}
.proto-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.proto-hint{display:flex;justify-content:space-between;gap:1rem;font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:#999;margin-top:1rem}
.proto-hint a{color:#999}
.mobile-note{display:none;font-size:.85rem;color:#777;margin:1rem 0 2rem}
.slide{width:100%;display:block;margin:2rem 0;border-radius:4px;object-fit:contain;transition:transform 0.3s ease,box-shadow 0.3s ease;cursor:zoom-in}
.slide:hover{transform:scale(1.02);box-shadow:0 20px 60px rgba(0,0,0,0.12)}
.section-label{font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;color:#999;margin:5rem 0 1rem}
footer{padding:3rem;border-top:1px solid #ddd;display:flex;justify-content:space-between;font-size:.75rem;color:#999}
footer a{color:#999;text-decoration:none}
#lightbox{position:fixed;inset:0;background:rgba(0,0,0,0.92);display:flex;align-items:center;justify-content:center;z-index:1000;opacity:0;pointer-events:none;transition:opacity .3s ease;cursor:zoom-out}
#lightbox.open{opacity:1;pointer-events:auto}
#lightbox img{max-width:90vw;max-height:90vh;object-fit:contain}
@media (max-width:760px){
  .brief{grid-template-columns:1fr;gap:1.5rem}
  .proto{display:none}
  .mobile-note{display:block}
  nav{padding:1.5rem}
  .hero{margin-top:5rem}
}
</style>
</head>
<body>

<nav>
  <a href="/">← Back</a>
  <a href="/">Nicolas Joannes</a>
</nav>

<div class="hero">
  <video src="/unite-gym.mp4" poster="/unite-gym-cover.jpg" autoplay muted loop playsinline>
    <img src="/unite-gym.gif" alt="The Unite Gym kiosk showing its animated loading screen" />
  </video>
</div>

<div class="content">
  <div class="meta">
    <div class="meta-item"><span>Category</span><p>Digital Design</p></div>
    <div class="meta-item"><span>Year</span><p>2025</p></div>
    <div class="meta-item"><span>Type</span><p>Kiosk App · Prototype</p></div>
    <div class="meta-item"><span>Team</span><p>Group of 4 · QMUL</p></div>
    <div class="meta-item"><span>Tools</span><p>Figma</p></div>
  </div>

  <h1>The Unite Gym</h1>
  <p class="lead">A tap-your-card kiosk that turns a gym membership card into a personal guide. It plans each workout around the machines that are actually free, shows the floor as a live heat map, and pairs members with a workout buddy so the gym feels less intimidating.</p>

  <div class="brief">
    <div><h2>Problem</h2><p>Beginners stuck to the edges of the gym, waited awkwardly for busy machines and avoided asking strangers for help. Anxiety, not equipment, was stopping people using the space.</p></div>
    <div><h2>Solution</h2><p>Members tap their card on touch pads around the gym. Sensors track which machines are free, the kiosk builds a timed routine around them, sends it to phone or watch, and matches people on similar routines.</p></div>
    <div><h2>Outcome</h2><p>A clickable kiosk prototype from onboarding to post-workout stats, with an animated logo reveal, a live availability heat map and a routine map that draws the path between stations.</p></div>
  </div>

  <p class="section-label">Research</p>
  <p class="research">Over three weeks we observed four very different spaces: the QMotion university gym, The Gym Group, an outdoor park gym and the Arch climbing wall. Coding the observations with grounded theory pointed to one core issue, how people interact with each other, and led to our question: <strong>how can technology in the gym embrace collaboration and reduce anxiety?</strong></p>
  <a class="report-link" href="/unite-gym-report.pdf" target="_blank" rel="noopener">Read the full research report · PDF, 39 pages ↗</a>

  <div class="proto">
    <div class="proto-frame">
      <iframe src={protoUrl} title="The Unite Gym interactive prototype" loading="lazy" allowfullscreen></iframe>
    </div>
    <div class="proto-hint">
      <span>Interactive prototype — starts on the loading screen, then tap through the kiosk</span>
      <a href="https://www.figma.com/proto/mHkbeEyZYY7Whn4YErCimD/The-Unite-Gym?node-id=13-351&starting-point-node-id=13%3A351&scaling=contain&content-scaling=fixed" target="_blank" rel="noopener">Open full screen ↗</a>
    </div>
  </div>
  <p class="mobile-note">The interactive prototype is built for desktop — open this page on a laptop to try it.</p>

  {slides.length > 0 && <p class="section-label">Screens</p>}
  {slides.map(s => <img class="slide" src={s.src} alt={s.alt} loading="lazy" />)}
</div>

<footer>
  <span>© 2026 Nicolas Joannes</span>
  <a href="/">← All projects</a>
</footer>

<div id="lightbox"><img id="lightbox-img" src="" alt="" /></div>
<script>
const lb = document.getElementById('lightbox') as HTMLElement;
const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
const slides = Array.from(document.querySelectorAll('.slide')) as HTMLImageElement[];
let lbIndex = 0;
slides.forEach((el, i) => {
  el.addEventListener('click', () => { lbIndex = i; lbImg.src = el.src; lb.classList.add('open'); });
});
lb.addEventListener('click', () => lb.classList.remove('open'));
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') { lb.classList.remove('open'); return; }
  if (!lb.classList.contains('open')) return;
  if (e.key === 'ArrowRight') { lbIndex = (lbIndex + 1) % slides.length; lbImg.src = slides[lbIndex].src; }
  if (e.key === 'ArrowLeft') { lbIndex = (lbIndex - 1 + slides.length) % slides.length; lbImg.src = slides[lbIndex].src; }
});
</script>
</body>
</html>
