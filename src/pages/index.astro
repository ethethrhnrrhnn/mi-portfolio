---
---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Nicolás Joannes — Industrial Designer</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;1,400&family=Inter:wght@300;400&display=swap');
*{margin:0;padding:0;box-sizing:border-box}
*,*::before,*::after,html,body,a,button,input{cursor:none !important}
html{scroll-behavior:smooth}
body{font-family:'Inter',sans-serif;color:#1a1a1a;background:#f7f6f3}

/* cursor — hidden on touch */
.cursor{position:fixed;width:8px;height:8px;background:#1a1a1a;border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);transition:transform .1s ease}
.cursor-follower{position:fixed;width:32px;height:32px;border:1px solid rgba(26,26,26,0.4);border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:left .08s ease,top .08s ease}
.cursor.expand{transform:translate(-50%,-50%) scale(3);opacity:.3}
@media(hover:none){.cursor,.cursor-follower{display:none}*,*::before,*::after,html,body,a,button,input{cursor:auto !important}}


/* nav */
nav{position:fixed;top:0;left:0;width:100%;padding:2rem 3rem;display:flex;justify-content:space-between;align-items:center;z-index:100;mix-blend-mode:multiply}
nav .logo{font-size:.75rem;font-weight:400;letter-spacing:.15em;text-transform:uppercase}
a{text-decoration:none}
nav ul{list-style:none;display:flex;gap:2rem}
nav ul a{color:#1a1a1a;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;opacity:.5;transition:opacity .2s}
nav ul a:hover{opacity:1}

/* slideshow */
#slideshow-wrap{margin:7rem 3rem 4rem}
#slideshow{position:relative;height:70svh;overflow:hidden;background:#f7f6f3}
.slide{position:absolute;inset:0;background-size:contain;background-position:center;background-repeat:no-repeat;opacity:0;transition:opacity 1.2s ease,background-position .6s ease-out;display:block;pointer-events:none}
.slide.active{opacity:1;pointer-events:auto}
#slide-caption{display:flex;justify-content:space-between;align-items:center;padding:1.8rem 0 0;gap:4rem}
#slide-title{font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;color:#1a1a1a;opacity:.6}
#slide-date{font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;color:#1a1a1a;opacity:.35}
.slide-nav{position:absolute;top:50%;transform:translateY(-50%);z-index:10;background:none;border:none;padding:.5rem 1.2rem;color:#1a1a1a;opacity:.25;font-size:1.4rem;transition:opacity .2s;pointer-events:auto}
.slide-nav:hover{opacity:.7}
#prev-btn{left:0}
#next-btn{right:0}

/* mobile */
@media(max-width:768px){
  *,*::before,*::after,html,body,a,button,input{cursor:auto !important}
  nav{padding:1.2rem 1.5rem}
  nav ul{gap:1.2rem}
  #slideshow-wrap{margin:4rem 1.5rem 3rem}
  #slideshow{height:65svh}
}
</style>
</head>
<body>

<div class="cursor" id="cursor"></div>
<div class="cursor-follower" id="follower"></div>

<nav>
  <span class="logo">Nicolas Joannes</span>
  <ul>
    <li><a href="/work">Work</a></li>
    <li><a href="/about">About</a></li>
    <li><a href="/contact">Contact</a></li>
  </ul>
</nav>


<div id="slideshow-wrap">
  <div id="slideshow">
    <button class="slide-nav" id="prev-btn">←</button>
    <button class="slide-nav" id="next-btn">→</button>
    <a href="/projects/calder-chair" class="slide active" data-title="Calder Chair" data-date="2026" style="background-image:url('/c1.png')"></a>
    <a href="/projects/atalanta-f1-team" class="slide" data-title="Atalanta F1 Team" data-date="2026" style="background-image:url('/A3.png')"></a>
    <a href="/projects/cycling-awareness-system" class="slide" data-title="Cycling Awareness System" data-date="2025" style="background-image:url('/cas-cover.png')"></a>
    <a href="/projects/flooding-assistance-vehicle" class="slide" data-title="Flooding Assistance Vehicle" data-date="2025" style="background-image:url('/fav-cover.png')"></a>
    <a href="/projects/swiftlift" class="slide" data-title="SwiftLift" data-date="2025" style="background-image:url('/swiftlift-cover.png')"></a>
    <a href="/projects/bed" class="slide" data-title="How to Make a Bed" data-date="2024" style="background-image:url('/bed-cover.jpg')"></a>
    <a href="/projects/f1-tour" class="slide" data-title="Autonomous F1 Vehicle" data-date="2026" style="background-image:url('/fcover.png')"></a>
    <a href="/projects/habitapp" class="slide" data-title="HabitApp" data-date="2023" style="background-image:url('/habitapp1.png')"></a>
    <a href="/projects/x-falcon" class="slide" data-title="X-Falcon" data-date="2026" style="background-image:url('/xf1.png')"></a>
  </div>
  <div id="slide-caption">
    <span id="slide-title">Calder Chair</span>
    <span id="slide-date">2026</span>
  </div>
</div>


<script>
// custom cursor (desktop only)
const cursor = document.getElementById('cursor') as HTMLElement;
const follower = document.getElementById('follower') as HTMLElement;
let mouseX = 0, mouseY = 0;
let followerX = 0, followerY = 0;

document.addEventListener('mousemove', e => {
  mouseX = e.clientX;
  mouseY = e.clientY;
  cursor.style.left = mouseX + 'px';
  cursor.style.top = mouseY + 'px';
});

function animateFollower() {
  followerX += (mouseX - followerX) * 0.15;
  followerY += (mouseY - followerY) * 0.15;
  follower.style.left = followerX + 'px';
  follower.style.top = followerY + 'px';
  requestAnimationFrame(animateFollower);
}
animateFollower();

document.querySelectorAll('a').forEach(el => {
  el.addEventListener('mouseenter', () => cursor.classList.add('expand'));
  el.addEventListener('mouseleave', () => cursor.classList.remove('expand'));
});

// page transition
document.querySelectorAll('a[href^="/projects"]').forEach(link => {
  link.addEventListener('click', e => {
    e.preventDefault();
    const href = (link as HTMLAnchorElement).getAttribute('href') as string;
    document.body.style.transition = 'opacity .4s ease';
    document.body.style.opacity = '0';
    setTimeout(() => { window.location.href = href; }, 400);
  });
});

window.addEventListener('load', () => {
  document.body.style.opacity = '1';
});

// slideshow
const slides = document.querySelectorAll('.slide');
const slideTitle = document.getElementById('slide-title') as HTMLElement;
const slideDate = document.getElementById('slide-date') as HTMLElement;
let current = 0;
let timer: ReturnType<typeof setInterval>;

function updateCaption(i: number) {
  const s = slides[i] as HTMLElement;
  slideTitle.textContent = s.dataset.title ?? '';
  slideDate.textContent = s.dataset.date ?? '';
}

function goTo(i: number) {
  (slides[current] as HTMLElement).style.backgroundPosition = 'center';
  slides[current].classList.remove('active');
  current = ((i % slides.length) + slides.length) % slides.length;
  slides[current].classList.add('active');
  updateCaption(current);
}

const slideshowEl = document.getElementById('slideshow') as HTMLElement;
slideshowEl.addEventListener('mousemove', e => {
  const rect = slideshowEl.getBoundingClientRect();
  const dx = (e.clientX - rect.left - rect.width / 2) / rect.width * 4;
  const dy = (e.clientY - rect.top - rect.height / 2) / rect.height * 4;
  const active = slideshowEl.querySelector('.slide.active') as HTMLElement;
  if (active) active.style.backgroundPosition = `calc(50% + ${dx}px) calc(50% + ${dy}px)`;
});
slideshowEl.addEventListener('mouseleave', () => {
  const active = slideshowEl.querySelector('.slide.active') as HTMLElement;
  if (active) active.style.backgroundPosition = 'center';
});

function startTimer() {
  clearInterval(timer);
  timer = setInterval(() => goTo(current + 1), 4000);
}

document.getElementById('prev-btn')!.addEventListener('click', e => {
  e.stopPropagation();
  goTo(current - 1);
  startTimer();
});

document.getElementById('next-btn')!.addEventListener('click', e => {
  e.stopPropagation();
  goTo(current + 1);
  startTimer();
});

startTimer();
</script>


</body>
</html>
