---
---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/png" href="/earth.png" />
<title>Nicolás Joannes — Industrial Designer</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&display=swap');
*{margin:0;padding:0;box-sizing:border-box}
*,*::before,*::after,html,body,a,button{cursor:none !important}
html{scroll-behavior:smooth}
body{font-family:'Inter',sans-serif;color:#0c0c0c;background:#f8f8f6;opacity:0;transition:opacity .5s ease;overflow-x:hidden}
@media(hover:none){*,*::before,*::after,html,body,a,button{cursor:auto !important}}

/* cursor — mix-blend-mode:difference keeps it visible over both dark + light */
.cursor{position:fixed;width:8px;height:8px;background:#fff;border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);transition:transform .15s ease;mix-blend-mode:difference}
.cursor-follower{position:fixed;width:36px;height:36px;border:1px solid #fff;border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:left .1s ease,top .1s ease;mix-blend-mode:difference}
.cursor.expand{transform:translate(-50%,-50%) scale(2.5);opacity:.5}
@media(hover:none){.cursor,.cursor-follower{display:none}}

/* nav — mix-blend-mode:difference auto-inverts over dark hero + light body */
nav{position:fixed;top:0;left:0;width:100%;padding:1.8rem 3rem;display:flex;justify-content:space-between;align-items:center;z-index:200;mix-blend-mode:difference}
.logo{font-size:.7rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:#fff;text-decoration:none}
a{text-decoration:none}
nav ul{list-style:none;display:flex;gap:2.5rem}
nav ul a{color:#fff;font-size:.65rem;font-weight:500;letter-spacing:.18em;text-transform:uppercase;opacity:.65;transition:opacity .2s}
nav ul a:hover{opacity:1}

/* hero */
#hero{position:relative;height:100svh;display:flex;align-items:flex-end;overflow:hidden;background:#0c0c0c}
.hero-bg{position:absolute;inset:0;background-image:url('/f1cover1.png');background-size:cover;background-position:center;opacity:.75;will-change:transform}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(155deg,rgba(0,0,0,0.05) 0%,rgba(0,0,0,0.6) 100%)}
.hero-content{position:relative;z-index:1;padding:3.5rem 3rem 4rem;width:100%}
.hero-eyebrow{font-size:.62rem;font-weight:500;letter-spacing:.32em;text-transform:uppercase;color:rgba(255,255,255,0.5);margin-bottom:1.2rem;display:block}
.hero-title{font-size:clamp(4rem,9.5vw,9rem);font-weight:700;line-height:.92;letter-spacing:-.03em;color:#fff;text-transform:uppercase}
.hero-scroll{position:absolute;bottom:2.5rem;right:3rem;z-index:1;font-size:.58rem;font-weight:500;letter-spacing:.28em;text-transform:uppercase;color:rgba(255,255,255,0.32);display:flex;align-items:center;gap:.65rem}
.hero-scroll::before{content:'';display:block;width:26px;height:1px;background:rgba(255,255,255,0.22)}

/* section divider + label */
.section-bar{display:flex;justify-content:space-between;align-items:baseline;padding:5rem 3rem 2.5rem;border-bottom:1px solid rgba(12,12,12,0.07)}
.section-label{font-size:.62rem;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:rgba(12,12,12,0.32)}
.section-link{font-size:.62rem;font-weight:500;letter-spacing:.15em;text-transform:uppercase;color:#cf4b2e;transition:opacity .2s}
.section-link:hover{opacity:.6}

/* card grid */
.work-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem;padding:1.5rem 3rem 7rem}
.card{display:block;color:inherit;overflow:hidden}
.card-image{width:100%;aspect-ratio:3/2;overflow:hidden}
.card-image-inner{width:100%;height:100%;background-size:cover;background-position:center;background-repeat:no-repeat;transition:transform .85s cubic-bezier(0.25,0.46,0.45,0.94)}
.card:hover .card-image-inner{transform:scale(1.05)}
.card-info{padding:.9rem 0 0}
.card-category{display:block;font-size:.58rem;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:rgba(12,12,12,0.36);margin-bottom:.38rem}
.card-title{display:block;font-size:1rem;font-weight:500;letter-spacing:-.01em;color:#0c0c0c;transition:color .25s}
.card:hover .card-title{color:rgba(12,12,12,0.42)}

/* scroll reveal */
.reveal{opacity:0;transform:translateY(30px);transition:opacity .9s cubic-bezier(0.25,0.46,0.45,0.94),transform .9s cubic-bezier(0.25,0.46,0.45,0.94)}
.reveal.visible{opacity:1;transform:translateY(0)}

@media(max-width:768px){
  nav{padding:1.4rem 1.5rem}
  nav ul{gap:1.5rem}
  .hero-content{padding:2.5rem 1.5rem 3rem}
  .hero-title{font-size:clamp(3rem,13vw,5rem)}
  .hero-scroll{right:1.5rem;bottom:1.8rem}
  .section-bar{padding:3.5rem 1.5rem 2rem}
  .work-grid{grid-template-columns:1fr;gap:1rem;padding:1rem 1.5rem 5rem}
}
</style>
</head>
<body>

<div class="cursor" id="cursor"></div>
<div class="cursor-follower" id="follower"></div>

<nav>
  <a href="/" class="logo">NJ</a>
  <ul>
    <li><a href="/work">Work</a></li>
    <li><a href="/contact">Contact</a></li>
  </ul>
</nav>

<section id="hero">
  <div class="hero-bg"></div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <span class="hero-eyebrow">Industrial Designer — London</span>
    <h1 class="hero-title">Nicolas<br>Joannes</h1>
  </div>
  <span class="hero-scroll">Scroll</span>
</section>

<div class="section-bar">
  <span class="section-label">Selected Work</span>
  <a href="/work" class="section-link">View All →</a>
</div>

<div class="work-grid">
  <a href="/projects/calder-chair" class="card reveal" style="transition-delay:0s">
    <div class="card-image"><div class="card-image-inner" style="background-image:url('/c1.png')"></div></div>
    <div class="card-info">
      <span class="card-category">Furniture Design — 2026</span>
      <span class="card-title">Calder Chair</span>
    </div>
  </a>
  <a href="/projects/atalanta-f1-team" class="card reveal" style="transition-delay:.12s">
    <div class="card-image"><div class="card-image-inner" style="background-image:url('/A3.png')"></div></div>
    <div class="card-info">
      <span class="card-category">Automotive Design — 2026</span>
      <span class="card-title">Atalanta F1 Team</span>
    </div>
  </a>
  <a href="/projects/cycling-awareness-system" class="card reveal" style="transition-delay:.06s">
    <div class="card-image"><div class="card-image-inner" style="background-image:url('/cas-cover.png')"></div></div>
    <div class="card-info">
      <span class="card-category">Product Design — 2025</span>
      <span class="card-title">Cycling Awareness System</span>
    </div>
  </a>
  <a href="/projects/x-falcon" class="card reveal" style="transition-delay:.18s">
    <div class="card-image"><div class="card-image-inner" style="background-image:url('/xf-cover.png')"></div></div>
    <div class="card-info">
      <span class="card-category">Automotive Design — 2026</span>
      <span class="card-title">X-Falcon</span>
    </div>
  </a>
</div>

<script>
const cursor = document.getElementById('cursor') as HTMLElement;
const follower = document.getElementById('follower') as HTMLElement;
let mouseX = 0, mouseY = 0, followerX = 0, followerY = 0;

document.addEventListener('mousemove', e => {
  mouseX = e.clientX; mouseY = e.clientY;
  cursor.style.left = mouseX + 'px';
  cursor.style.top = mouseY + 'px';
});
function animateFollower() {
  followerX += (mouseX - followerX) * 0.15;
  followerY += (mouseY - followerY) * 0.15;
  follower.style.left = followerX + 'px';
  follower.style.top = followerY + 'px';
  requestAnimationFrame(animateFollower);
}
animateFollower();

document.querySelectorAll('a').forEach(el => {
  el.addEventListener('mouseenter', () => cursor.classList.add('expand'));
  el.addEventListener('mouseleave', () => cursor.classList.remove('expand'));
});

window.addEventListener('load', () => { document.body.style.opacity = '1'; });

document.querySelectorAll('a[href^="/projects"]').forEach(link => {
  link.addEventListener('click', e => {
    e.preventDefault();
    const href = (link as HTMLAnchorElement).getAttribute('href') as string;
    document.body.style.transition = 'opacity .4s ease';
    document.body.style.opacity = '0';
    setTimeout(() => { window.location.href = href; }, 400);
  });
});

// hero image parallax on scroll
const heroBg = document.querySelector('.hero-bg') as HTMLElement;
window.addEventListener('scroll', () => {
  if (heroBg) heroBg.style.transform = `translateY(${window.scrollY * 0.35}px)`;
}, { passive: true });

// scroll reveal
const io = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    if (entry.isIntersecting) { entry.target.classList.add('visible'); io.unobserve(entry.target); }
  });
}, { threshold: 0.08 });
document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>

</body>
</html>
