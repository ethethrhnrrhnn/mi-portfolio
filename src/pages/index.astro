---
const projects = [
  { slug: 'vybil', title: 'Vybil', category: 'Consumer Design', year: '2026', image: '/vybil-cover.png' },
  { slug: 'spiralwuchs-side-table', title: 'Spiralwuchs Side Table', category: 'Furniture Design', year: '2026', image: '/scover.png' },
  { slug: 'calder-chair', title: 'Calder Chair', category: 'Furniture Design', year: '2026', image: '/c1.png' },
  { slug: 'atalanta-f1-team', title: 'Atalanta F1 Team', category: 'Automotive Design', year: '2026', image: '/A3.png' },
  { slug: 'f1-tour', title: 'Autonomous F1 Vehicle', category: 'Automotive Design', year: '2026', image: '/f1cover1.png' },
  { slug: 'x-falcon', title: 'X-Falcon', category: 'Automotive Design', year: '2026', image: '/xf-cover.png' },
  { slug: 'cycling-awareness-system', title: 'Cycling Awareness System', category: 'Product Design', year: '2025', image: '/cas-cover.png' },
  { slug: 'flooding-assistance-vehicle', title: 'Flooding Assistance Vehicle', category: 'Product Design', year: '2025', image: '/fav-cover1.png' },
  { slug: 'swiftlift', title: 'SwiftLift', category: 'Product Design', year: '2025', image: '/swiftlift-cover.png', hideTitle: true },
  { slug: 'bed', title: 'How to Make a Bed', category: 'Product Design', year: '2024', image: '/bed-cover.jpg', hideTitle: true },
  { slug: 'habitapp', title: 'HabitApp', category: 'UX Design', year: '2023', image: '/habitapp2.png' },
];
---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/png" href="/earth.png" />
<title>Nicolás Joannes — Industrial Designer</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&display=swap');
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Inter',sans-serif;color:#0c0c0c;background:#0c0c0c;opacity:0;transition:opacity .5s ease;overflow-x:hidden}

/* nav — floating liquid glass pill */
nav{
  position:fixed;top:1.1rem;left:50%;transform:translateX(-50%);
  width:calc(100% - 3.5rem);max-width:1120px;
  padding:.65rem 1rem .65rem 1.4rem;
  display:flex;justify-content:space-between;align-items:center;
  z-index:200;
  background:linear-gradient(145deg,rgba(28,28,28,0.58) 0%,rgba(12,12,12,0.48) 100%);
  backdrop-filter:blur(24px) saturate(160%);
  -webkit-backdrop-filter:blur(24px) saturate(160%);
  border:1px solid rgba(255,255,255,0.11);
  border-radius:100px;
  box-shadow:
    inset 0 1.5px 0 rgba(255,255,255,0.22),
    inset 0 -1px 0 rgba(255,255,255,0.04),
    inset 1px 0 rgba(255,255,255,0.06),
    inset -1px 0 rgba(255,255,255,0.06),
    0 8px 32px rgba(0,0,0,0.24),
    0 2px 6px rgba(0,0,0,0.14);
  transition:box-shadow .5s ease,background .5s ease;
}
nav:hover{
  background:linear-gradient(145deg,rgba(30,30,30,0.64) 0%,rgba(14,14,14,0.54) 100%);
  box-shadow:
    inset 0 1.5px 0 rgba(255,255,255,0.3),
    inset 0 -1px 0 rgba(255,255,255,0.06),
    inset 1px 0 rgba(255,255,255,0.08),
    inset -1px 0 rgba(255,255,255,0.08),
    0 12px 40px rgba(0,0,0,0.3),
    0 2px 6px rgba(0,0,0,0.18);
}
.logo{font-size:.66rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,0.88);text-decoration:none;padding:.3rem .2rem}
a{text-decoration:none}
nav ul{list-style:none;display:flex;gap:.25rem;align-items:center}
nav ul li a{
  position:relative;
  display:block;
  color:rgba(255,255,255,0.65);
  font-size:.63rem;font-weight:500;letter-spacing:.16em;text-transform:uppercase;
  padding:.42rem .85rem;
  border-radius:100px;
  transition:color .3s ease;
  isolation:isolate;
}
nav ul li a::before{
  content:'';
  position:absolute;inset:0;z-index:-1;
  border-radius:100px;
  background:rgba(255,255,255,0.11);
  border:1px solid rgba(255,255,255,0.1);
  box-shadow:inset 0 1px 0 rgba(255,255,255,0.18);
  transform:scale(0.65) translateY(2px);
  opacity:0;
  transition:
    transform .5s cubic-bezier(0.34,1.56,0.64,1),
    opacity .3s ease,
    border-radius .5s cubic-bezier(0.34,1.56,0.64,1);
}
nav ul li a:hover{color:rgba(255,255,255,1)}
nav ul li a:hover::before{
  transform:scale(1) translateY(0);
  opacity:1;
  border-radius:38% 62% 55% 45% / 45% 40% 60% 55%;
}

/* intro drawing */
.intro{position:relative;height:100svh;overflow:hidden;background:#f8f8f6;display:flex;align-items:center;justify-content:center}
.intro-drawing{width:100%;height:100%;object-fit:cover}

/* full-screen project sections */
.project{position:relative;height:100svh;overflow:hidden;background:#0c0c0c}
.project-bg{position:absolute;inset:0;background-size:cover;background-position:center;background-repeat:no-repeat;transition:transform 1s cubic-bezier(0.25,0.46,0.45,0.94)}
.project:hover .project-bg{transform:scale(1.04)}
.project-overlay{position:absolute;inset:0;background:linear-gradient(190deg,rgba(0,0,0,0.05) 0%,rgba(0,0,0,0.75) 100%)}
.project-link{display:block;position:absolute;inset:0;z-index:1}
.project-content{position:absolute;left:0;right:0;bottom:0;padding:3.5rem 3rem 4rem;color:#fff}
.project-index{font-size:.62rem;font-weight:500;letter-spacing:.28em;text-transform:uppercase;color:rgba(255,255,255,0.4);margin-bottom:1.1rem;display:block}
.project-category{font-size:.62rem;font-weight:500;letter-spacing:.28em;text-transform:uppercase;color:rgba(255,255,255,0.55);margin-bottom:1rem;display:block}
.project-title{font-size:clamp(2.8rem,7.5vw,6.5rem);font-weight:700;line-height:.95;letter-spacing:-.03em;text-transform:uppercase;margin-bottom:1.5rem}
.project-cta{font-size:.6rem;font-weight:500;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,0.7);display:inline-flex;align-items:center;gap:.65rem;transition:color .25s,gap .25s}
.project-cta::after{content:'→'}
.project:hover .project-cta{color:#fff;gap:.9rem}
.project-scroll{position:absolute;bottom:2.5rem;right:3rem;z-index:1;font-size:.58rem;font-weight:500;letter-spacing:.28em;text-transform:uppercase;color:rgba(255,255,255,0.32);display:flex;align-items:center;gap:.65rem}
.project-scroll::before{content:'';display:block;width:26px;height:1px;background:rgba(255,255,255,0.22)}

/* scroll reveal */
.reveal{opacity:0;transform:translateY(30px);transition:opacity .9s cubic-bezier(0.25,0.46,0.45,0.94),transform .9s cubic-bezier(0.25,0.46,0.45,0.94)}
.reveal.visible{opacity:1;transform:translateY(0)}

/* footer */
footer{background:#0c0c0c;color:rgba(255,255,255,0.4);padding:3rem;display:flex;justify-content:space-between;font-size:.75rem}
footer a{color:rgba(255,255,255,0.7);text-decoration:none;transition:color .2s}
footer a:hover{color:#fff}

@media(max-width:768px){
  nav{top:.7rem;width:calc(100% - 2rem);padding:.55rem .6rem .55rem 1rem}
  nav ul{gap:.15rem}
  .project-content{padding:2.5rem 1.5rem 3rem}
  .project-scroll{right:1.5rem;bottom:1.8rem}
  footer{padding:2rem 1.5rem;flex-direction:column;gap:.75rem}
}
</style>
</head>
<body>

<nav>
  <a href="/" class="logo">Nicolas Joannes</a>
  <ul>
    <li><a href="/work">Work</a></li>
    <li><a href="/contact">Contact</a></li>
  </ul>
</nav>

<section class="intro">
  <img class="intro-drawing" src="/intro-drawing.svg" alt="" />
</section>

{projects.map((p, i) => (
  <section class="project">
    <div class="project-bg" style={`background-image:url('${p.image}')`}></div>
    <div class="project-overlay"></div>
    <a href={`/projects/${p.slug}`} class="project-link" aria-label={p.title}></a>
    <div class="project-content reveal">
      <span class="project-index">{String(i + 1).padStart(2, '0')} / {String(projects.length).padStart(2, '0')}</span>
      <span class="project-category">{p.category} — {p.year}</span>
      {!p.hideTitle && <h2 class="project-title">{p.title}</h2>}
      <span class="project-cta">View Project</span>
    </div>
  </section>
))}

<footer>
  <span>© 2026 Nicolas Joannes</span>
  <a href="/contact">Get in Touch →</a>
</footer>

<script>

function showPage() { document.body.style.opacity = '1'; }
if (document.readyState === 'complete') { showPage(); } else { window.addEventListener('load', showPage); }
window.addEventListener('pageshow', showPage);
window.addEventListener('pagehide', e => { if ((e as PageTransitionEvent).persisted) { document.body.style.transition = 'none'; document.body.style.opacity = '1'; } });

document.querySelectorAll('a[href^="/projects"]').forEach(link => {
  link.addEventListener('click', e => {
    e.preventDefault();
    const href = (link as HTMLAnchorElement).getAttribute('href') as string;
    document.body.style.transition = 'opacity .4s ease';
    document.body.style.opacity = '0';
    setTimeout(() => { window.location.href = href; }, 400);
  });
});

// scroll reveal
const io = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    if (entry.isIntersecting) { entry.target.classList.add('visible'); io.unobserve(entry.target); }
  });
}, { threshold: 0.3 });
document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>

</body>
</html>
