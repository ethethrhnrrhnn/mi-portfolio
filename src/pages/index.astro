),#0000),radial-gradient(3px 4px at 150px 79px,var(--c1) 100%,#0000 150%),radial-gradient(4px 100px at 0px 210px,var(--c),#0000),radial-gradient(4px 100px at 300px 210px,var(--c),#0000),radial-gradient(3px 4px at 150px 105px,var(--c1) 100%,#0000 150%);background-size:300px 235px,300px 235px,300px 235px,300px 252px,300px 252px,300px 252px,300px 150px,300px 150px,300px 150px,300px 253px,300px 253px,300px 253px,300px 204px,300px 204px,300px 204px,300px 134px,300px 134px,300px 134px,300px 179px,300px 179px,300px 179px,300px 299px,300px 299px,300px 299px,300px 215px,300px 215px,300px 215px,300px 281px,300px 281px,300px 281px,300px 158px,300px 158px,300px 158px,300px 210px,300px 210px,300px 210px;animation:blobRain 150s linear infinite}
@keyframes blobRain{0%{background-position:0px 220px,3px 220px,151.5px 337.5px,25px 24px,28px 24px,176.5px 150px,50px 16px,53px 16px,201.5px 91px,75px 224px,78px 224px,226.5px 350.5px,100px 19px,103px 19px,251.5px 121px,125px 120px,128px 120px,276.5px 187px,150px 31px,153px 31px,301.5px 120.5px,175px 235px,178px 235px,326.5px 384.5px,200px 121px,203px 121px,351.5px 228.5px,225px 224px,228px 224px,376.5px 364.5px,250px 26px,253px 26px,401.5px 105px,275px 75px,278px 75px,426.5px 180px}to{background-position:0px 6800px,3px 6800px,151.5px 6917.5px,25px 13632px,28px 13632px,176.5px 13758px,50px 5416px,53px 5416px,201.5px 5491px,75px 17175px,78px 17175px,226.5px 17301.5px,100px 5119px,103px 5119px,251.5px 5221px,125px 8428px,128px 8428px,276.5px 8495px,150px 9876px,153px 9876px,301.5px 9965.5px,175px 13391px,178px 13391px,326.5px 13540.5px,200px 14741px,203px 14741px,351.5px 14848.5px,225px 18770px,228px 18770px,376.5px 18910.5px,250px 5082px,253px 5082px,401.5px 5161px,275px 6375px,278px 6375px,426.5px 6480px}}
</style>
</head>
<body>
<div class="bg-blob"></div>

<div class="cursor" id="cursor"></div>
<div class="cursor-follower" id="follower"></div>

<nav>
  <span class="logo">Nicolas Joannes</span>
  <ul>
    <li><a href="/work">Work</a></li>
<li><a href="/contact">Contact</a></li>
  </ul>
</nav>


<div id="slideshow-wrap">
  <div id="slideshow">
    <button class="slide-nav" id="prev-btn">←</button>
    <button class="slide-nav" id="next-btn">→</button>
    <div id="slide-track">
      <a href="/projects/calder-chair" class="slide active" data-title="Calder Chair" data-date="2026" style="background-image:url('/c1.png')"></a>
      <a href="/projects/atalanta-f1-team" class="slide" data-title="Atalanta F1 Team" data-date="2026" style="background-image:url('/A3.png')"></a>
      <a href="/projects/cycling-awareness-system" class="slide" data-title="Cycling Awareness System" data-date="2025" style="background-image:url('/cas-cover.png')"></a>
      <a href="/projects/flooding-assistance-vehicle" class="slide" data-title="Flooding Assistance Vehicle" data-date="2025" style="background-image:url('/fav-cover1.png')"></a>
      <a href="/projects/swiftlift" class="slide" data-title="SwiftLift" data-date="2025" style="background-image:url('/swiftlift-cover.png')"></a>
      <a href="/projects/bed" class="slide" data-title="How to Make a Bed" data-date="2024" style="background-image:url('/bed-cover.jpg')"></a>
      <a href="/projects/f1-tour" class="slide" data-title="Autonomous F1 Vehicle" data-date="2026" style="background-image:url('/f1cover1.png')"></a>
      <a href="/projects/habitapp" class="slide" data-title="HabitApp" data-date="2023" style="background-image:url('/habitapp1.png')"></a>
      <a href="/projects/x-falcon" class="slide" data-title="X-Falcon" data-date="2026" style="background-image:url('/xf-cover.png')"></a>
    </div>
  </div>
  <div id="slide-caption">
    <span id="slide-title">Calder Chair</span>
    <span id="slide-date">2026</span>
  </div>
</div>


<script>
// custom cursor (desktop only)
const cursor = document.getElementById('cursor') as HTMLElement;
const follower = document.getElementById('follower') as HTMLElement;
let mouseX = 0, mouseY = 0;
let followerX = 0, followerY = 0;

document.addEventListener('mousemove', e => {
  mouseX = e.clientX;
  mouseY = e.clientY;
  cursor.style.left = mouseX + 'px';
  cursor.style.top = mouseY + 'px';
});

function animateFollower() {
  followerX += (mouseX - followerX) * 0.15;
  followerY += (mouseY - followerY) * 0.15;
  follower.style.left = followerX + 'px';
  follower.style.top = followerY + 'px';
  requestAnimationFrame(animateFollower);
}
animateFollower();

document.querySelectorAll('a').forEach(el => {
  el.addEventListener('mouseenter', () => cursor.classList.add('expand'));
  el.addEventListener('mouseleave', () => cursor.classList.remove('expand'));
});

// page transition
document.querySelectorAll('a[href^="/projects"]').forEach(link => {
  link.addEventListener('click', e => {
    e.preventDefault();
    const href = (link as HTMLAnchorElement).getAttribute('href') as string;
    document.body.style.transition = 'opacity .4s ease';
    document.body.style.opacity = '0';
    setTimeout(() => { window.location.href = href; }, 400);
  });
});

window.addEventListener('load', () => {
  document.body.style.opacity = '1';
});

// slideshow
const slides = document.querySelectorAll('.slide');
const slideTrack = document.getElementById('slide-track') as HTMLElement;
const slideTitle = document.getElementById('slide-title') as HTMLElement;
const slideDate = document.getElementById('slide-date') as HTMLElement;
let current = 0;
let timer: ReturnType<typeof setInterval>;

// size the track and each slide dynamically
const count = slides.length;
slideTrack.style.width = (count * 100) + '%';
slides.forEach(s => { (s as HTMLElement).style.width = (100 / count) + '%'; });

function updateCaption(i: number) {
  const s = slides[i] as HTMLElement;
  slideTitle.textContent = s.dataset.title ?? '';
  slideDate.textContent = s.dataset.date ?? '';
}

function goTo(i: number) {
  (slides[current] as HTMLElement).style.backgroundPosition = 'center';
  slides[current].classList.remove('active');
  current = ((i % count) + count) % count;
  slides[current].classList.add('active');
  slideTrack.style.transform = `translateX(-${current * (100 / count)}%)`;
  updateCaption(current);
}

const slideshowEl = document.getElementById('slideshow') as HTMLElement;
slideshowEl.addEventListener('mousemove', e => {
  const rect = slideshowEl.getBoundingClientRect();
  const dx = (e.clientX - rect.left - rect.width / 2) / rect.width * 4;
  const dy = (e.clientY - rect.top - rect.height / 2) / rect.height * 4;
  const active = slides[current] as HTMLElement;
  active.style.backgroundPosition = `calc(50% + ${dx}px) calc(50% + ${dy}px)`;
});
slideshowEl.addEventListener('mouseleave', () => {
  (slides[current] as HTMLElement).style.backgroundPosition = 'center';
});

function startTimer() {
  clearInterval(timer);
  timer = setInterval(() => goTo(current + 1), 4000);
}

document.getElementById('prev-btn')!.addEventListener('click', e => {
  e.stopPropagation();
  goTo(current - 1);
  startTimer();
});

document.getElementById('next-btn')!.addEventListener('click', e => {
  e.stopPropagation();
  goTo(current + 1);
  startTimer();
});

startTimer();
</script>


</body>
</html>
